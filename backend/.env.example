# Multi-Agent API Keys (Set these to different keys to bypass free-tier rate limits)
GEMINI_API_KEY_DIAGNOSIS=your_gemini_api_key_1
GEMINI_API_KEY_VALUE=your_gemini_api_key_2
GEMINI_API_KEY_PLANNER=your_gemini_api_key_3
GEMINI_MODEL=gemini-3.5-flash-lite

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Database
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/revivepay

# Server Config
PORT=5000
DEMO_MODE=false

# Optional: Groq Integration (if used)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL="openai/gpt-oss-20b"
